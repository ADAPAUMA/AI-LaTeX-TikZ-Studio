# .env.example
# -------------
# Copy this file to .env and fill in your real values.
# Never commit your .env file to version control.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your credentials
#   streamlit run app.py

# -------------------------------------------------------
# REQUIRED — IBM watsonx.ai credentials
# -------------------------------------------------------

# IBM Cloud IAM API key
# Generate at: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your-ibm-cloud-api-key-here

# watsonx.ai service endpoint URL
# Find at: IBM Cloud → Resource list → your Watson Studio / watsonx.ai instance
# Common values:
#   https://us-south.ml.cloud.ibm.com
#   https://eu-de.ml.cloud.ibm.com
#   https://eu-gb.ml.cloud.ibm.com
#   https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Your watsonx.ai project ID
# Find at: watsonx.ai → Manage → General → Project ID
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# -------------------------------------------------------
# OPTIONAL — Model selection
# -------------------------------------------------------

# IBM Granite model to use for generation
# Recommended: ibm/granite-13b-instruct-v2
# Other options: ibm/granite-20b-code-instruct-v2
#                ibm/granite-34b-code-instruct
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2
